# Copy to .env and adjust. Nothing here is required to start the app, but without an LLM
# provider it runs in the rule-based *fallback* mode (labelled as such in the API and UI).

LOG_LEVEL=INFO

# --- LLM provider -------------------------------------------------------------------------------
# One of: groq | openai | openrouter | ollama | custom | none
#
# Groq (default, free tier):
#   1. Create a free key at https://console.groq.com/keys
#   2. Put it in LLM_API_KEY below.
#   3. Start the app. The model defaults to llama-3.1-8b-instant.
#
# Ollama (local, no key):
#   1. Install Ollama and run:  ollama pull qwen2.5:1.5b   (or a larger model if you have the RAM)
#   2. Set LLM_PROVIDER=ollama and LLM_MODEL=qwen2.5:1.5b
#   Small local models on CPU are slow; raise LLM_TIMEOUT_SECONDS (e.g. 120) and keep
#   LLM_MAX_CONCURRENCY=1.
#
# OpenAI / OpenRouter: set LLM_PROVIDER and LLM_API_KEY. Defaults are gpt-4o-mini and
# meta-llama/llama-3.1-8b-instruct.
#
# custom: any OpenAI-compatible server. Set LLM_BASE_URL (ending in /v1) and LLM_MODEL.
LLM_PROVIDER=groq
LLM_API_KEY=
# Optional overrides of the provider preset:
# LLM_BASE_URL=
# LLM_MODEL=

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=2
# Ask the API for JSON mode (response_format=json_object). Disable for servers that reject it.
LLM_JSON_MODE=true

# On-disk response cache keyed by a hash of provider, model, prompt version and full prompt.
# It stores resume-derived text, so disable it (or clear LLM_CACHE_DIR) for real candidate data.
LLM_CACHE_ENABLED=true
LLM_CACHE_DIR=.cache/llm

# Prompt set under app/prompts/<version>/
PROMPT_VERSION=v1

# --- Ask about candidates (RAG) ------------------------------------------------------------------
ASK_TOP_K=5
MAX_QUESTION_CHARS=500
# Screenings kept in memory for follow-up questions (lost on restart).
MAX_SCREENINGS_KEPT=20

# --- Uploads --------------------------------------------------------------------------------------
MAX_FILE_SIZE_MB=5
MAX_FILES=20

# --- Similarity backend: auto | tfidf | sbert ---------------------------------------------------
# auto uses sentence-transformers if installed and the model loads, otherwise TF-IDF.
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Scoring (deterministic; the LLM never produces the number) ---------------------------------
WEIGHT_SKILLS=0.55
WEIGHT_SEMANTIC=0.30
WEIGHT_EXPERIENCE=0.15
SHORTLIST_THRESHOLD=70
MAYBE_THRESHOLD=45
