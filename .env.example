# Copy to .env and adjust. Every setting is optional.

LOG_LEVEL=INFO

# Upload limits
MAX_FILE_SIZE_MB=5
MAX_FILES=20

# Similarity backend: auto | tfidf | sbert
# auto uses sentence-transformers if installed and the model loads, otherwise TF-IDF.
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional LLM explanations (any OpenAI-compatible chat completions API).
# Leave LLM_API_KEY empty to use the built-in rule-based explanations.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
LLM_TIMEOUT_SECONDS=30

# Scoring
WEIGHT_SKILLS=0.55
WEIGHT_SEMANTIC=0.30
WEIGHT_EXPERIENCE=0.15
SHORTLIST_THRESHOLD=70
MAYBE_THRESHOLD=45
